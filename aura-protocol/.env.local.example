# Copy this file to .env.local and fill in your Supabase project values
# (Project Settings -> API in the Supabase dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Server-only. Used for the cron reset route and admin flag review.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Shared secret checked by /api/cron/reset and /api/cron/settle-season so
# only your scheduler can call them
CRON_SECRET=change-me-to-a-long-random-string

# Razorpay (razorpay.com dashboard -> Settings -> API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
# Settings -> Webhooks -> add https://yourapp.com/api/payments/webhook,
# subscribe to "payment.captured", copy the signing secret here
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
